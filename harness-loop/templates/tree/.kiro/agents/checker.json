{
  "name": "checker",
  "description": "Checker in the maker-checker loop: re-runs evidence, tries to falsify, and is the only agent allowed to set status=done. Write-restricted to state files.",
  "prompt": "file://../../loop/checker-prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "feature_list.json",
        "progress.md",
        "session-handoff.md",
        "trace/**",
        "memory/checker/**"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/INDEX.md",
    "file://../../loop/goal.md",
    "file://../../feature_list.json",
    "file://../../docs/testing-standards.md",
    "file://../../docs/constraints.md",
    "file://../../docs/assumptions.md",
    "file://../../docs/cross-cutting.md",
    "file://../../docs/definition-of-done.md",
    "file://../../DECISIONS.md",
    "file://../../memory/checker/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs checker session-start"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs checker session-end"
      }
    ]
  }
}
