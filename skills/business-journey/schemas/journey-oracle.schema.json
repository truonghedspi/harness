{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey-oracle.schema.json",
  "type": "object",
  "required": ["schema", "id", "requirement", "publicInput", "observations", "invariants", "deadlineMs", "diagnostics"],
  "properties": {
    "schema": { "const": "journey-oracle/1" },
    "id": { "type": "string", "pattern": "^JRN-[A-Z0-9-]+$" },
    "requirement": { "type": "string", "minLength": 1 },
    "publicInput": { "type": "object", "required": ["protocol", "operation", "correlationField"] },
    "observations": { "type": "array", "minItems": 1 },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deadlineMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "faultProbe": { "type": "object" }
  }
}
