{
  "name": "test-implementer",
  "description": "Turns validated test conditions into running test code, red first. Writes tests only — never the implementation they judge.",
  "prompt": "file://../../harness/prompts/test-implementer.md",
  "tools": [
    "read",
    "write",
    "shell",
    "*"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4",
  "toolsSettings": {
    "write": {
      "allowedPaths": []
    }
  },
  "resources": [
    "file://../../harness/AGENTS.md",
    "file://../../harness/docs/constraints.md",
    "file://../../harness/docs/INDEX.md",
    "file://../../harness/skills/test-design/SKILL.md",
    "file://../../harness/skills/test-design/references/anti-patterns.md",
    "file://../../harness/docs/reference/test-authoring.md",
    "file://../../harness/feature_list.digest.md",
    "file://../../harness/docs/testing-standards.md",
    "file://../../harness/loop/goal.md",
    "file://../../harness/memory/test-implementer/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node harness/tools/trace.mjs test-implementer session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "execute_bash",
        "command": "node harness/tools/trace.mjs test-implementer tool-use shell"
      },
      {
        "matcher": "fs_read",
        "command": "node harness/tools/telemetry.mjs --runtime kiro --actor test-implementer"
      },
      {
        "matcher": "read",
        "command": "node harness/tools/telemetry.mjs --runtime kiro --actor test-implementer"
      },
      {
        "matcher": "grep",
        "command": "node harness/tools/telemetry.mjs --runtime kiro --actor test-implementer"
      },
      {
        "matcher": "glob",
        "command": "node harness/tools/telemetry.mjs --runtime kiro --actor test-implementer"
      },
      {
        "matcher": "execute_bash",
        "command": "node harness/tools/telemetry.mjs --runtime kiro --actor test-implementer"
      }
    ],
    "stop": [
      {
        "command": "node harness/tools/trace.mjs test-implementer session-end"
      }
    ]
  }
}
