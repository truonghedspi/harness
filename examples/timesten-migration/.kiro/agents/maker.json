{
  "name": "maker",
  "description": "Maker in the maker\u2013checker migration loop: advances exactly one unit by one pipeline state per iteration, with honest evidence. Cannot set done.",
  "prompt": "file://../../loop/maker-prompt.md",
  "tools": [
    "read",
    "write",
    "shell",
    "*"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "resources": [
    "file://../../AGENTS.md",
    "file://../../loop/goal.md",
    "file://../../feature_list.json",
    "file://../../progress.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs maker session-start"
      },
      {
        "command": "./init.sh"
      }
    ],
    "postToolUse": [
      {
        "matcher": "execute_bash",
        "command": "node tools/trace.mjs maker tool-use shell"
      },
      {
        "matcher": "fs_write",
        "command": "node tools/trace.mjs maker tool-use write"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs maker session-end"
      }
    ]
  }
}
