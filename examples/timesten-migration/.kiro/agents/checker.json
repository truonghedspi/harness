{
  "name": "checker",
  "description": "Checker in the maker\u2013checker migration loop: re-runs evidence, tries to falsify, and is the only one allowed to set status=done.",
  "prompt": "file://../../loop/checker-prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "feature_list.json",
        "progress.md",
        "session-handoff.md",
        "trace/**"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../loop/goal.md",
    "file://../../feature_list.json",
    "file://../../docs/02-parity-testing.md",
    "file://../../docs/03-aeron-determinism-rules.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs checker session-start"
      },
      {
        "command": "./init.sh"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs checker session-end"
      }
    ]
  }
}
