{
  "name": "maker",
  "description": "Implements one feature step with evidence; cannot set done.",
  "prompt": "file://../../prompts/maker.md",
  "tools": [
    "read",
    "write",
    "shell",
    "*"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4",
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../feature_list.digest.md",
    "file://../../memory/maker/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs maker session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor maker"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor maker"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor maker"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor maker"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor maker"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs maker session-end"
      }
    ]
  }
}
