{
  "name": "checker",
  "description": "Final-acceptance checker: runs only after every non-blocked feature is handed off, replays evidence against the integrated delivery, and is the only agent allowed to set status=done. Write-restricted to state files.",
  "prompt": "file://../../loop/checker-prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4.5",
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "feature_list.json",
        "progress.md",
        "session-handoff.md",
        "trace/**",
        "memory/checker/**"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../docs/INDEX.md",
    "file://../../feature_list.digest.md",
    "file://../../docs/testing-standards.md",
    "file://../../docs/assumptions.md",
    "file://../../docs/cross-cutting.md",
    "file://../../docs/definition-of-done.md",
    "file://../../DECISIONS.md",
    "file://../../loop/goal.md",
    "file://../../memory/checker/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs checker session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor checker"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor checker"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor checker"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor checker"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor checker"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs checker session-end"
      }
    ]
  }
}
