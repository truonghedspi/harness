{
  "name": "orchestrator",
  "description": "The human-facing front door: reports loop state, natively spawns the node loop/route.mjs names, and escalates decisions. Uses scripts only as a fallback; does not choose nodes or write product files.",
  "prompt": "file://../../prompts/orchestrator.md",
  "tools": [
    "read",
    "shell",
    "write",
    "subagent"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4",
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "session-handoff.md",
        "progress.md",
        "loop/approval.md",
        "trace/**",
        "memory/orchestrator/**"
      ]
    },
    "subagent": {
      "availableAgents": [
        "checker",
        "design-facilitator",
        "feature-planner",
        "harness-setup",
        "maker",
        "test-designer",
        "test-implementer"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../docs/reference/graph.md",
    "file://../../docs/reference/presenting-and-proposing.md",
    "file://../../docs/reference/human-attention.md",
    "file://../../feature_list.digest.md",
    "file://../../loop/goal.md",
    "file://../../docs/INDEX.md",
    "file://../../memory/orchestrator/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs orchestrator session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs orchestrator session-end"
      }
    ]
  },
  "welcomeMessage": "Reports where the loop is, spawns the next sub-agent the router names, and brings decisions to you. It never picks the node itself."
}
