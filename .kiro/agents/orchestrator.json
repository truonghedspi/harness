{
  "name": "orchestrator",
  "description": "Human interface, minimal context gathering, design and planning.",
  "prompt": "file://../../prompts/orchestrator.md",
  "tools": [
    "read",
    "shell",
    "write",
    "subagent"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4.5",
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "feature_list.json",
        "docs/design/**",
        "docs/architecture.md",
        "docs/assumptions.md",
        "docs/cross-cutting.md",
        "DECISIONS.md",
        "spikes/**",
        "loop/design-approval.json",
        "loop/context-packets/**",
        "loop/goal.md",
        "session-handoff.md",
        "progress.md",
        "trace/**",
        "memory/orchestrator/**"
      ]
    },
    "subagent": {
      "availableAgents": [
        "harness-manager",
        "test-agent",
        "maker",
        "checker"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../docs/INDEX.md",
    "file://../../docs/reference/design-engineering.md",
    "file://../../skills/feature-planning/SKILL.md",
    "file://../../feature_list.digest.md",
    "file://../../loop/goal.md",
    "file://../../memory/orchestrator/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs orchestrator session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor orchestrator"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs orchestrator session-end"
      }
    ]
  }
}
