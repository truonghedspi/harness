{
  "name": "harness-setup",
  "description": "Set up and validate the harness against the real environment: toolchain, MCP connectivity, real verification commands, and a green ./init.sh baseline. Setup only — no feature work.",
  "prompt": "file://../../prompts/harness-setup.md",
  "tools": [
    "read",
    "write",
    "shell",
    "*"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4",
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../feature_list.digest.md",
    "file://../../docs/architecture.md",
    "file://../../docs/INDEX.md",
    "file://../../docs/cross-cutting.md",
    "file://../../docs/assumptions.md",
    "file://../../memory/harness-setup/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs harness-setup session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor harness-setup"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor harness-setup"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor harness-setup"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor harness-setup"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor harness-setup"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs harness-setup session-end"
      }
    ]
  },
  "welcomeMessage": "Harness setup: I will verify the toolchain, confirm MCP connectivity, fill in the real verification commands, and get ./init.sh green. Setup only — no feature work."
}
