{
  "name": "test-designer",
  "description": "Turns the spec into test conditions WITHOUT reading the implementation. The independent oracle: designs what must be true, so the test cannot become a transcript of the code it judges.",
  "prompt": "file://../../prompts/test-designer.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "includeMcpJson": true,
  "model": "claude-sonnet-4",
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "tests/design/**",
        "feature_list.json",
        "docs/assumptions.md",
        "progress.md",
        "session-handoff.md",
        "trace/**",
        "memory/test-designer/**"
      ]
    }
  },
  "resources": [
    "file://../../AGENTS.md",
    "file://../../docs/constraints.md",
    "file://../../docs/INDEX.md",
    "file://../../skills/test-design/SKILL.md",
    "file://../../docs/reference/test-authoring.md",
    "file://../../feature_list.digest.md",
    "file://../../docs/testing-standards.md",
    "file://../../docs/assumptions.md",
    "file://../../loop/goal.md",
    "file://../../memory/test-designer/MEMORY.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "node tools/trace.mjs test-designer session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor test-designer"
      },
      {
        "matcher": "read",
        "command": "node tools/telemetry.mjs --runtime kiro --actor test-designer"
      },
      {
        "matcher": "grep",
        "command": "node tools/telemetry.mjs --runtime kiro --actor test-designer"
      },
      {
        "matcher": "glob",
        "command": "node tools/telemetry.mjs --runtime kiro --actor test-designer"
      },
      {
        "matcher": "execute_bash",
        "command": "node tools/telemetry.mjs --runtime kiro --actor test-designer"
      }
    ],
    "stop": [
      {
        "command": "node tools/trace.mjs test-designer session-end"
      }
    ]
  }
}
